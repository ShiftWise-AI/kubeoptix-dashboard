# This file is used to configure the dashboard container when running in OpenShift.
ENV=openshift
# Internal URL of the Harvester service, reachable from the dashboard container.
HARVESTER_API_URL=http://harvester-api:8000
# Internal URL of the Analyzer service, reachable from the dashboard container.
ANALYZER_API_URL=http://analyzer-api:8000
# Internal URL of the Reporter service, reachable from the dashboard container.
REPORTER_API_URL=http://reporter-api:8000
# Timezone for the dashboard container. This is used to display timestamps in the correct timezone.
TZ=America/Sao_Paulo

