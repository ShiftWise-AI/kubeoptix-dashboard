# This file is used to configure the dashboard container when running in OpenShift.
ENV=development
# Internal URL of the Harvester service, reachable from the dashboard container.
HARVESTER_API_URL=https://harvester-shiftwise-ai.apps-crc.testing
# Internal URL of the Analyzer service, reachable from the dashboard container.
ANALYZER_API_URL=https://analyzer-shiftwise-ai.apps-crc.testing
# Reporter route used by the local Vite proxy.
REPORTER_API_URL=https://reporter-shiftwise-ai.apps-crc.testing
# Core AI (predictive) route used by the local Vite proxy.
CORE_AI_API_URL=https://core-ai-api-shiftwise-ai.apps-crc.testing
# Timezone for the dashboard container. This is used to display timestamps in the correct timezone.
TZ=UTC-3

